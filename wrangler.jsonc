{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auditable-deep-research-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "auditable-research-vectors"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "auditable-research-db",
      "database_id": "7712a854-7ff4-40f7-aa13-b45db350235e",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS"
  },
  "vars": {
    "ENVIRONMENT": "production"
  }
}
